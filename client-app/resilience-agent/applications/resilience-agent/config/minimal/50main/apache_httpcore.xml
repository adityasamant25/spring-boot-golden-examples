<?xml version="1.0" encoding="UTF-8"?>
<resilience-configuration>
    <enhancer>apache_httpcore</enhancer>
    <ruleset>
        <rule>
            <class>org.apache.http.protocol.HttpRequestExecutor</class>
            <method>execute(HttpRequest, HttpClientConnection, HttpContext)</method>
            <execute-before>bindHttpRequest$resilienceagent(p1, p3)</execute-before>
            <create-span name="web.request.out"/>
            <break-point/>
        </rule>
    </ruleset>
</resilience-configuration>
