<project name="installer" default="install">
    <property name="NETCRACKER_HOME" location="./"/>

    <property name="patch_name" value="resilience-agent"/>
    <property name="component_id" value="resilience-agent"/>

    <!-- Setup this property to dir with installer-->
    <property name="INSTALLER_HOME" location="${NETCRACKER_HOME}/AutoInstaller"/>

    <import file="${INSTALLER_HOME}/build.xml"/>

    <property file="${INSTALLER_HOME}/config_RA.properties"/>

    <property name="step_list" value="1,2,3,4,5,6"/>

    <!-- step list which need to be executed while installing over existing version -->
    <property name="update_step_list" value="1,2,3,4,5,6"/>

    <!-- move old data from profiler to resilience-agent -->
    <property name="node_step_list" value="1,3,5"/>

    <property name="bulk_step_list" value=""/>
    <property name="bulk_node_step_list" value=""/>

    <property name="uninstall_step_list" value="51,52,53,54,55,56"/>
    <property name="uninstall_step_list_node" value="51,53,55"/>

    <property name="skip_clear_cache" value="true"/>

    <!--general_steps-->
    <if>
        <isset property="resilience_agent_target"/>
        <then>
            <if>
                <not>
                    <or>
                        <equals arg1="${resilience_agent_target}" arg2="TOMS" casesensitive="false"/>
                        <equals arg1="${resilience_agent_target}" arg2="MANO" casesensitive="false"/>
                        <equals arg1="${resilience_agent_target}" arg2="TBAPI" casesensitive="false"/>
                        <equals arg1="${resilience_agent_target}" arg2="RBM" casesensitive="false"/>
                    </or>
                </not>
                <then>
                    <fail message="resilience_agent_target property is set to incorrect value in AutoInstaller/config_RA.properties. It should be set to: TOMS, MANO, TBAPI or RBM."/>
                </then>
            </if>
        </then>
        <else>
            <if>
                <istrue value="${NC_ENV}"/>
                <then>
                    <property name="resilience_agent_target" value="TOMS"/>
                </then>
                <elseif>
                    <istrue value="${MANO_ENV}"/>
                    <then>
                        <property name="resilience_agent_target" value="MANO"/>
                    </then>
                </elseif>
                <elseif>
                    <istrue value="${RBM_ENV}"/>
                    <then>
                        <property name="resilience_agent_target" value="RBM"/>
                    </then>
                </elseif>
                <elseif>
                    <or>
                        <isset property="TBAPI_HOME"/>
                        <isset property="resilience_agent_tbapi_config_file"/>
                        <available file="tbapi"/>
                        <available file="telecom-business-api"/>
                        <available file="telecom-business-api.conf"/>
                        <available file="tbapi-spring-boot.conf"/>
                        <available file="tbapi.conf"/>
                    </or>
                    <then>
                        <property name="resilience_agent_target" value="TBAPI"/>
                    </then>
                </elseif>
            </if>
        </else>
    </if>

    <if>
        <not><isset property="resilience_agent_tomcat_folder_mask"/></not>
        <then><property name="resilience_agent_tomcat_folder_mask" value="tomcat*"/></then>
    </if>

    <target name="add_tomcat_opts">
        <if>
            <not>
                <equals trim="true" arg1="" arg2="${resilience_agent_tomcat_folder_mask}"/>
            </not>
            <then>
                <!-- Doing it in BASH script due to a bug in ANT, which always scans all folders under specified folder, while we only need to scan the specified folder -->
                <!-- It can lead to a long scanning of some huge folder under NC_HOME like ei_folder -->
                <exec executable="/bin/bash" outputproperty="add_tomcat_opts_out">
                    <arg value="install/add_tomcat_opts.sh"/>
                    <arg value="${resilience_agent_tomcat_folder_mask}"/>
                </exec>
                <echo message="${add_tomcat_opts_out}"/>
            </then>
        </if>
    </target>

    <target name="delete_tomcat_opts">
        <if>
            <not>
                <equals trim="true" arg1="" arg2="${resilience_agent_tomcat_folder_mask}"/>
            </not>
            <then>
                <!-- Doing it in BASH script due to a bug in ANT, which always scans all folders under specified folder, while we only need to scan the specified folder -->
                <!-- It can lead to a long scanning of some huge folder under NC_HOME like ei_folder -->
                <exec executable="/bin/bash" outputproperty="delete_tomcat_opts_out">
                    <arg value="install/delete_tomcat_opts.sh"/>
                    <arg value="${resilience_agent_tomcat_folder_mask}"/>
                </exec>
                <echo message="${delete_tomcat_opts_out}"/>
            </then>
        </if>
    </target>

    <target name="delete_ra_files">
        <!-- Delete old jars, so previous version can be installed -->
        <delete>
            <fileset dir="applications/resilience-agent/config" includes="**/*.xml" excludes="**/*.override.xml"/>
            <fileset dir="applications/resilience-agent/lib" includes="*.jar"/>
        </delete>
    </target>

    <!--/general_install_steps-->

    <!--toms_steps-->
    <condition property="toms_weblogic">
        <and>
             <equals arg1="${resilience_agent_target}" arg2="TOMS" casesensitive="false"/>
             <not>
                 <equals arg1="${ai.application.server.platform}" arg2="wildfly"/>
             </not>
        </and>
    </condition>

    <condition property="toms_wildfly">
        <and>
             <equals arg1="${resilience_agent_target}" arg2="TOMS" casesensitive="false"/>
             <equals arg1="${ai.application.server.platform}" arg2="wildfly"/>
        </and>
    </condition>

    <target name="add_toms_option">
        <antcall target="add.java_option">
            <param name="java_arg" value="-javaagent:applications/resilience-agent/lib/agent.jar"/>
        </antcall>
    </target>

    <target name="uninstall_ra_from_admin_server" if="${ai.wl.server.isCluster}">
        <antcall target="remove.java_option">
            <param name="java_arg" value="-javaagent:applications/resilience-agent/lib/agent.jar"/>
            <param name="ai.wl.server.isCluster" value="false"/>
        </antcall>
    </target>

    <target name="remove_toms_option" depends="uninstall_ra_from_admin_server">
        <antcall target="remove.java_option">
            <param name="java_arg" value="-javaagent:applications/resilience-agent/lib/agent.jar"/>
        </antcall>
    </target>

    <target name="update_version_toms">
        <antcall target="execute_sql">
            <param name="sql.workdir" value="${NETCRACKER_HOME}/scripts"/>
            <param name="sql.file" value="resilience-agent.sql"/>
        </antcall>
    </target>
    <!--/toms_steps-->

    <!--mano_steps-->
    <target name="touch_ra_files">
        <touch>
            <fileset dir="applications/resilience-agent">
                <include name="**/*.jar"/>
                <include name="**/*.xml"/>
            </fileset>
            <mapper type="regexp" from="^(.*)$" to="applications/resilience-agent/\1.skipdeploy"/>
        </touch>
    </target>
    <!--/mano_steps-->

    <!--tbapi_steps-->
    <!--calculate_tbapi_home-->
    <if>
        <equals arg1="${resilience_agent_target}" arg2="TBAPI" casesensitive="false"/>
        <then>
            <if>
                <not>
                    <isset property="TBAPI_HOME"/>
                </not>
                <then>
                    <if>
                        <available file="tbapi"/>
                        <then>
                            <property name="TBAPI_HOME" location="tbapi"/>
                        </then>
                        <elseif>
                            <available file="telecom-business-api"/>
                            <then>
                                <property name="TBAPI_HOME" location="telecom-business-api"/>
                            </then>
                        </elseif>
                        <else>
                            <property name="TBAPI_HOME" location="./"/>
                        </else>
                    </if>
                </then>
            </if>
        </then>
    </if>
    <!--/calculate_tbapi_home-->
    <!--calculate_tbapi_config_file-->
    <if>
        <equals arg1="${resilience_agent_target}" arg2="TBAPI" casesensitive="false"/>
        <then>
            <if>
                <isset property="resilience_agent_tbapi_config_file"/>
                <then>
                    <if>
                        <available file="${TBAPI_HOME}/${resilience_agent_tbapi_config_file}"/>
                        <then>
                            <property name="TBAPI_CONFIG_FILE" location="${TBAPI_HOME}/${resilience_agent_tbapi_config_file}"/>
                        </then>
                        <else>
                            <fail message="File ${TBAPI_HOME}/${resilience_agent_tbapi_config_file} doesn't exist. Specify correct values of TBAPI_HOME and resilience_agent_tbapi_config_file properties in AutoInstaller/config_RA.properties"/>
                        </else>
                    </if>
                </then>
                <else>
                    <if>
                        <and>
                            <available file="${TBAPI_HOME}/telecom-business-api.conf"/>
                            <resourcecontains resource="${TBAPI_HOME}/telecom-business-api.conf" substring="JAVA_OPTS"/>
                        </and>
                        <then>
                            <property name="TBAPI_CONFIG_FILE" location="${TBAPI_HOME}/telecom-business-api.conf"/>
                        </then>
                        <elseif>
                            <and>
                                <available file="${TBAPI_HOME}/tbapi-spring-boot.conf"/>
                                <resourcecontains resource="${TBAPI_HOME}/tbapi-spring-boot.conf" substring="JAVA_OPTS"/>
                            </and>
                            <then>
                                <property name="TBAPI_CONFIG_FILE" location="${TBAPI_HOME}/tbapi-spring-boot.conf"/>
                            </then>
                        </elseif>
                        <elseif>
                            <and>
                                <available file="${TBAPI_HOME}/tbapi.conf"/>
                                <resourcecontains resource="${TBAPI_HOME}/tbapi.conf" substring="JAVA_OPTS"/>
                            </and>
                            <then>
                                <property name="TBAPI_CONFIG_FILE" location="${TBAPI_HOME}/tbapi.conf"/>
                            </then>
                        </elseif>
                        <else>
                            <echo message="TBAPI_HOME is calculated to ${TBAPI_HOME}"/>
                            <fail message="Either TBAPI_HOME or resilience_agent_tbapi_config_file aren't set(or set to not existing file) in AutoInstaller/config_RA.properties."/>
                        </else>
                    </if>
                </else>
            </if>
        </then>
    </if>
    <!--/calculate_tbapi_config_file-->

    <macrodef name="ra.add.springboot.opts">
        <attribute name="file"/>
        <attribute name="agent.jar" default="${NETCRACKER_HOME}/applications/resilience-agent/lib/agent.jar"/>
        <sequential>
            <if>
                <and>
                    <available file="@{file}"/>
                    <not>
                        <resourcecontains resource="@{file}" substring="-javaagent:@{agent.jar}"/>
                    </not>
                    <not>
                        <os family="windows" />
                    </not>
                </and>
                <then>
                    <echo message="Adding -javaagent:@{agent.jar} to @{file}"/>
                    <concat destfile="@{file}" append="true" fixlastline="true"><![CDATA[
JAVA_OPTS="$JAVA_OPTS -javaagent:@{agent.jar}"]]></concat>
                </then>
            </if>
        </sequential>
    </macrodef>

    <macrodef name="ra.delete.springboot.opts">
        <attribute name="file"/>
        <attribute name="agent.jar" default="${NETCRACKER_HOME}/applications/resilience-agent/lib/agent.jar"/>
        <sequential>
            <if>
                <and>
                    <available file="@{file}"/>
                    <resourcecontains resource="@{file}" substring="-javaagent:@{agent.jar}"/>
                    <not>
                        <os family="windows" />
                    </not>
                </and>
                <then>
                    <echo message="Removing -javaagent:@{agent.jar} from @{file}"/>
                    <replace file="@{file}" >
                        <replacetoken><![CDATA[
JAVA_OPTS="$JAVA_OPTS -javaagent:@{agent.jar}"]]></replacetoken>
                        <replacevalue/>
                    </replace>
                </then>
            </if>
        </sequential>
    </macrodef>
    <!--/tbapi_steps-->

    <!--rbm_steps-->
    <macrodef name="rbm.add.java.options">
        <attribute name="file"/>
        <attribute name="agent.jar" default="${INFINYS_ROOT}/applications/resilience-agent/lib/agent.jar"/>
        <sequential>
            <if>
                <not><available file="@{file}"/></not>
                <then>
                    <fail message="@{file} doesn't exist"/>
                </then>
            </if>
            <if>
                <not><resourcecontains resource="@{file}" substring="RA_OPTIONS"/></not>
                <then>
                    <echo message="Adding RA_OPTIONS block to @{file}"/>
                    <concat destfile="@{file}" append="true" fixlastline="true"><![CDATA[
RA_OPTIONS=""
JAVA_OPTIONS="$${JAVA_OPTIONS} $${RA_OPTIONS}"
export JAVA_OPTIONS]]></concat>
                </then>
            </if>

            <echo message="Adding -javaagent:@{agent.jar} to @{file}"/>
            <replace file="@{file}" token='RA_OPTIONS="' value='RA_OPTIONS="-javaagent:@{agent.jar}'/>
        </sequential>
    </macrodef>

    <macrodef name="rbm.remove.java.options">
        <attribute name="file"/>
        <attribute name="agent.jar" default="${INFINYS_ROOT}/applications/resilience-agent/lib/agent.jar"/>
        <sequential>
            <if>
                <not><available file="@{file}"/></not>
                <then>
                    <fail message="@{file} doesn't exist"/>
                </then>
            </if>
            <if>
                <resourcecontains resource="@{file}" substring="applications/resilience-agent/lib/agent.jar"/>
                <then>
                    <echo message="Removing javaagent from @{file}"/>
                    <replaceregexp file="@{file}" match='\s*-javaagent:(.*?)(applications/resilience-agent/lib/agent.jar)' replace="" byline="true" />
                </then>
            </if>
            <replaceregexp file="@{file}" match='RA_OPTIONS="\s+"' replace='RA_OPTIONS=""' byline="true" />
            <if>
                <resourcecontains resource="@{file}" substring='RA_OPTIONS=""'/>
                <then>
                    <echo message="Removing RA_OPTIONS block from @{file}"/>
                    <replace file="@{file}" >
                        <replacetoken><![CDATA[
RA_OPTIONS=""
JAVA_OPTIONS="${JAVA_OPTIONS} ${RA_OPTIONS}"
export JAVA_OPTIONS]]></replacetoken>
                        <replacevalue/>
                    </replace>
                </then>
            </if>
        </sequential>
    </macrodef>

    <target name="rbm_update_version">
        <antcall target="execute_sql">
            <param name="sql.workdir" value="${NETCRACKER_HOME}/scripts"/>
            <param name="sql.file" value="resilience-agent-rbm.sql"/>
        </antcall>
    </target>
    <!--/rbm_steps-->


    <!--install_steps-->
    <target name="step1" description="pre_install">
        <echo message="RA target environment is calculated to ${resilience_agent_target}"/>

        <if>
            <equals arg1="${resilience_agent_target}" arg2="TBAPI" casesensitive="false"/>
            <then>
                <echo message="TBAPI_HOME is calculated to ${TBAPI_HOME}"/>
                <echo message="TBAPI_CONFIG_FILE is calculated to ${TBAPI_CONFIG_FILE}"/>
            </then>
        </if>

        <chmod perm="+x" file="applications/resilience-agent/ra-cmd.sh"/>
    </target>

    <target name="step2" description="pre_install_admin_node_only">

    </target>

    <target name="step3" description="install">
        <if>
            <equals arg1="${resilience_agent_target}" arg2="TBAPI" casesensitive="false"/>
            <then>
                <ra.add.springboot.opts file="${TBAPI_CONFIG_FILE}"/>
            </then>
            <elseif>
                <equals arg1="${resilience_agent_target}" arg2="RBM" casesensitive="false"/>
                <then>
                    <rbm.remove.java.options file="${domain.dir}/bin/setDomainEnv.sh"/>
                    <rbm.add.java.options file="${domain.dir}/bin/setDomainEnv.sh"/>
                </then>
            </elseif>
        </if>

        <antcall target="add_tomcat_opts"/>
    </target>

    <target name="step4" description="install_admin_node_only">
        <if>
            <equals arg1="${resilience_agent_target}" arg2="TOMS" casesensitive="false"/>
            <then>
                <antcall target="add_toms_option"/>
            </then>
        </if>
    </target>

    <target name="step5" description="post_install">
        <if>
            <equals arg1="${resilience_agent_target}" arg2="MANO" casesensitive="false"/>
            <then>
                <antcall target="touch_ra_files"/>
            </then>
        </if>
    </target>

    <target name="step6" description="post_install_admin_node_only">
        <if>
            <equals arg1="${resilience_agent_target}" arg2="TOMS" casesensitive="false"/>
            <then>
                <antcall target="update_version_toms"/>
            </then>
            <elseif>
                <equals arg1="${resilience_agent_target}" arg2="RBM" casesensitive="false"/>
                <then>
                    <antcall target="rbm_update_version"/>
                </then>
            </elseif>
        </if>
    </target>
    <!--/install_steps-->

    <!--uninstall_steps-->
    <target name="step51" description="pre_uninstall">
        <echo message="RA target environment is calculated to ${resilience_agent_target}"/>
        <if>
            <equals arg1="${resilience_agent_target}" arg2="TBAPI" casesensitive="false"/>
            <then>
                <echo message="TBAPI_HOME is calculated to ${TBAPI_HOME}"/>
                <echo message="TBAPI_CONFIG_FILE is calculated to ${TBAPI_CONFIG_FILE}"/>
            </then>
        </if>
    </target>

    <target name="step52" description="pre_uninstall_admin_node_only">
    </target>

    <target name="step53" description="uninstall">
        <if>
            <equals arg1="${resilience_agent_target}" arg2="TBAPI" casesensitive="false"/>
            <then>
                <ra.delete.springboot.opts file="${TBAPI_CONFIG_FILE}"/>
            </then>
            <elseif>
                <equals arg1="${resilience_agent_target}" arg2="RBM" casesensitive="false"/>
                <then>
                    <rbm.remove.java.options file="${domain.dir}/bin/setDomainEnv.sh"/>
                </then>
            </elseif>
        </if>

        <antcall target="delete_tomcat_opts"/>
    </target>

    <target name="step54" description="uninstall_admin_node_only">
        <if>
            <equals arg1="${resilience_agent_target}" arg2="TOMS" casesensitive="false"/>
            <then>
                <antcall target="remove_toms_option"/>
            </then>
        </if>
    </target>

    <target name="step55" description="post_uninstall">
        <antcall target="delete_ra_files"/>
    </target>

    <target name="step56" description="post_uninstall_admin_node_only">

    </target>
    <!--/uninstall_steps-->
</project>
